{
  "name": "@mpw/core",
  "version": "0.1.0",
  "description": "Platform-independent TypeScript implementation of Master Password algorithm v3",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "CC-BY-4.0",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9.34.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.10"
  }
}
